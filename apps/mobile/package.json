{
  "name": "@librarius/mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Native Android/iOS shell (Capacitor) around the @librarius/web bundle.",
  "scripts": {
    "build": "cap sync",
    "typecheck": "tsc --noEmit",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "doctor": "cap doctor",
    "assets:generate": "capacitor-assets generate --android && node scripts/finish-android-icons.mjs",
    "store:assets": "node scripts/generate-store-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@librarius/web": "workspace:*",
    "sharp": "0.35.5",
    "typescript": "~5.9.3"
  }
}
