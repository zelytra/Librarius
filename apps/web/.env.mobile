# Build-time configuration of the bundle that ships inside the native container
# (`pnpm mobile:build`, Vite mode `mobile`). Nothing secret belongs here: everything in a
# VITE_ variable is readable in the shipped bundle, and this file is committed on purpose —
# an APK built on any machine has to reach the same API as one built in CI.
#
# The web build does not read this file. It keeps its relative URLs and its own
# VITE_OIDC_* build arguments (`apps/web/Dockerfile`).

# The container's own origin is `https://localhost` (Android) or `capacitor://localhost`
# (iOS), so the API has to be named in full — #527.
VITE_API_BASE_URL=https://librarius.zelytra.fr

# Keycloak behind the same ingress (`/auth`), and the public client whose redirect URI is
# the app's custom scheme — #528. `librarius-web`'s redirect URIs are web origins and would
# refuse `fr.zelytra.librarius://auth`.
VITE_OIDC_AUTHORITY=https://librarius.zelytra.fr/auth/realms/librarius
VITE_OIDC_CLIENT_ID=librarius-mobile
