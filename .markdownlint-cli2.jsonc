// markdownlint rules for the repository documentation.
// Deliberately permissive: it targets structural errors (headings, lists,
// tables, links), not cosmetic formatting.
{
  "config": {
    "default": true,
    // The documents are written with deliberately long lines (tables, URLs).
    "MD013": false,
    // Several sections may share a heading ("Context", "Reference").
    "MD024": { "siblings_only": true },
    // Emphasis is sometimes used as a pseudo-heading inside callouts.
    "MD036": false,
    // Occasional inline HTML is tolerated.
    "MD033": false,
    // Local URLs (localhost, cluster) are written as-is.
    "MD034": false,
    // Compact table separators (`|---|---|`), the style used across the repository.
    "MD060": false,
    // The debt list in INVENTORY.md is numbered continuously across sections:
    // GitHub issues refer to those numbers ("debt #13").
    "MD029": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "**/node_modules/**", "apps/api/target/**"]
}
