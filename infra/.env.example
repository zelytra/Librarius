# Environment of the compose.prod.yml stack. Copy to infra/.env (git-ignored)
# and fill in every value below: they have no default, the stack fails to start
# while one of them is missing.
#
#   cp infra/.env.example infra/.env
#
# Generate a value with: openssl rand -base64 24

POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
GF_ADMIN_PASSWORD=

# Optional, defaults are fine for a local run.
# POSTGRES_USER=librarius
# POSTGRES_DB=librarius
# KEYCLOAK_ADMIN=admin
# GF_ADMIN_USER=admin
# KC_HOSTNAME=http://localhost:8081
# OIDC_AUTH_SERVER_URL=http://localhost:8081/realms/librarius
# WEB_PORT=8088
# GRAFANA_PORT=3000
